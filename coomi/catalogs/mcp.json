{
  "version": 1,
  "verified_at": "2026-07-11",
  "entries": [
    {
      "id": "filesystem",
      "name": "Filesystem",
      "description": "在用户明确授权的目录范围内读取、写入和管理文件。",
      "homepage": "https://github.com/modelcontextprotocol/servers/tree/main/src/filesystem",
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "{{allowed_path}}"],
      "url_template": "",
      "env": {},
      "headers": {},
      "required_env": [],
      "required_parameters": [
        {
          "key": "allowed_path",
          "label": "允许访问的目录",
          "description": "Filesystem MCP 只能访问该目录。请使用绝对路径。",
          "placeholder": "F:\\Projects\\MyProject",
          "required": true,
          "secret": false,
          "kind": "directory"
        }
      ],
      "runtime_requirements": ["Node.js", "npx"],
      "platforms": ["Windows", "macOS", "Linux"],
      "official": true,
      "verified": true,
      "license": "MIT",
      "install_notes": "只授权实际需要的最小目录，不要直接授权整个用户目录或磁盘根目录。"
    },
    {
      "id": "git",
      "name": "Git",
      "description": "读取 Git 状态、提交历史、差异和仓库元数据。",
      "homepage": "https://github.com/modelcontextprotocol/servers/tree/main/src/git",
      "transport": "stdio",
      "command": "uvx",
      "args": ["mcp-server-git", "--repository", "{{repository_path}}"],
      "url_template": "",
      "env": {},
      "headers": {},
      "required_env": [],
      "required_parameters": [
        {
          "key": "repository_path",
          "label": "Git 仓库目录",
          "description": "需要访问的本地 Git 仓库绝对路径。",
          "placeholder": "F:\\Projects\\Repository",
          "required": true,
          "secret": false,
          "kind": "git_repository"
        }
      ],
      "runtime_requirements": ["Git", "uv/uvx", "Python"],
      "platforms": ["Windows", "macOS", "Linux"],
      "official": true,
      "verified": true,
      "license": "MIT",
      "install_notes": "仅配置需要检查的仓库，写操作前仍应审查具体工具能力。"
    },
    {
      "id": "github",
      "name": "GitHub",
      "description": "通过 GitHub 官方 MCP 管理仓库、Issue、Pull Request 和 Actions。",
      "homepage": "https://github.com/github/github-mcp-server",
      "transport": "stdio",
      "command": "docker",
      "args": ["run", "-i", "--rm", "-e", "GITHUB_PERSONAL_ACCESS_TOKEN", "ghcr.io/github/github-mcp-server"],
      "url_template": "",
      "env": {"GITHUB_PERSONAL_ACCESS_TOKEN": "{{github_token}}"},
      "headers": {},
      "required_env": [
        {
          "key": "github_token",
          "label": "GitHub Personal Access Token",
          "description": "建议使用 Fine-grained PAT，并仅授予必要仓库和权限。",
          "placeholder": "github_pat_...",
          "required": true,
          "secret": true,
          "kind": "token"
        }
      ],
      "required_parameters": [],
      "runtime_requirements": ["Docker"],
      "platforms": ["Windows", "macOS", "Linux"],
      "official": true,
      "verified": true,
      "license": "MIT",
      "install_notes": "Token 会保存在 ~/.coomi/config/mcp_servers.json；请限制权限并保护该文件。"
    },
