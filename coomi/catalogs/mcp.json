    {
      "id": "postgresql",
      "name": "PostgreSQL MCP Pro",
      "description": "分析 PostgreSQL 架构、查询计划、索引和数据库健康状态。",
      "homepage": "https://github.com/crystaldba/postgres-mcp",
      "transport": "stdio",
      "command": "uvx",
      "args": ["postgres-mcp", "--access-mode=restricted"],
      "url_template": "",
      "env": {"DATABASE_URI": "{{database_uri}}"},
      "headers": {},
      "required_env": [
        {
          "key": "database_uri",
          "label": "PostgreSQL DATABASE_URI",
          "description": "建议使用只读或最小权限账户。",
          "placeholder": "postgresql://user:password@localhost:5432/database",
          "required": true,
          "secret": true,
          "kind": "postgres_uri"
        }
      ],
      "required_parameters": [],
      "runtime_requirements": ["uv/uvx", "Python", "可访问的 PostgreSQL"],
      "platforms": ["Windows", "macOS", "Linux"],
      "official": false,
      "verified": true,
      "license": "MIT",
      "install_notes": "默认使用 restricted 模式；生产数据库必须使用最小权限连接。"
