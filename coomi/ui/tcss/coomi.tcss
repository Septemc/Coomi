/* ===== Phase 3: 多面板布局 ===== */

Screen {
    layout: vertical;
    background: #000000;
}

Screen:focus-within {
    background: #000000;
}

/* Header - 顶部导航 */
Header {
    dock: top;
    height: 1;
    background: #0d1117;
    color: #c9d1d9;
}

Header:focus-within {
    background: #161b22;
}

/* RichLog - 消息流 */
#message-log {
    height: 1fr;
    padding: 0 1;
    background: #000000;
}

#message-log:focus-within {
    background: #000000;
}

/* PlanPanel - Plan Mode 问询面板 (即时渲染) */
PlanPanel {
    height: auto;
    max-height: 50%;
    min-height: 8;
    padding: 0 1;
    background: #0d1117;
    border-bottom: solid #30363d;
}

/* CommandList - 斜杠指令列表 */
CommandList {
    height: auto;
    max-height: 15;
    padding: 0 1;
    background: #0d1117;
    border-bottom: solid #30363d;
}

/* StreamingPreview - 流式预览 */
#stream-preview {
    height: auto;
    max-height: 40%;
    padding: 0 1;
    background: #000000;
    color: #c9d1d9;
    overflow-y: auto;
}

/* StatusPanel - 状态栏 */
#status-panel {
    height: 2;
    padding: 0 1;
    background: #161b22;
    border-top: solid #30363d;
}

/* PromptInput - 用户输入 */
#prompt-input {
    dock: bottom;
    height: 5;
    padding: 0 1;
    background: #1c2333;
    border: solid #30363d;
}

#prompt-input:focus {
    background: #1c2333;
    border: solid #00a8df;
}

/* Command Palette */
CommandPalette {
    align: center middle;
}

#palette-container {
    width: 60;
    height: auto;
    max-height: 20;
    background: #161b22;
    border: solid #30363d;
}

#palette-title {
    height: 1;
    padding: 0 1;
    background: #0d1117;
    color: #58a6ff;
}

#palette-input {
    height: 1;
    margin: 0 1;
    background: #0d1117;
}

#palette-commands {
    height: auto;
    max-height: 15;
    padding: 0 1;
}

/* ModelPicker — 模型选择器 */
ModelPicker {
    height: auto;
    max-height: 15;
    padding: 0 1;
    background: #0d1117;
    border-bottom: solid #30363d;
}

/* ContextPicker — 上下文窗口选择器 */
ContextPicker {
    height: auto;
    max-height: 12;
    padding: 0 1;
    background: #0d1117;
    border-bottom: solid #30363d;
}

/* SettingsScreen — 设置面板 */
SettingsScreen {
    layout: vertical;
    align: center middle;
}

#settings-container {
    width: 50;
    height: auto;
    max-height: 25;
    overflow-y: auto;
    background: #161b22;
    border: solid #30363d;
}

#settings-title {
    height: 1;
    padding: 0 1;
    background: #0d1117;
    color: #58a6ff;
}

#settings-options {
    height: auto;
    max-height: 20;
    overflow-y: auto;
    padding: 0 1;
}

#settings-guide {
    width: 92%;
    max-width: 132;
    height: auto;
    max-height: 18;
    overflow-y: auto;
    margin-top: 1;
    padding: 0 1;
    background: #0d1117;
    border: solid #30363d;
    color: #c9d1d9;
}

/* ProviderListScreen — Provider 列表 */
ProviderListScreen {
    align: center middle;
}

#provider-list-container {
    width: 60;
    height: auto;
    max-height: 25;
    overflow-y: auto;
    background: #161b22;
    border: solid #30363d;
}

#provider-list-title {
    height: 1;
    padding: 0 1;
    background: #0d1117;
    color: #58a6ff;
}

#provider-list-items {
    height: auto;
    max-height: 20;
    overflow-y: auto;
    padding: 0 1;
}

/* ProviderEditScreen — Provider 编辑表单 */
ProviderEditScreen {
    align: center middle;
}

#provider-edit-container {
    width: 76;
    height: auto;
    max-height: 92%;
    overflow-y: auto;
    background: #161b22;
    border: solid #30363d;
}

#provider-edit-title {
    height: 1;
    padding: 0 1;
    background: #0d1117;
    color: #58a6ff;
}

#provider-edit-form {
    height: auto;
    max-height: 28;
    overflow-y: auto;
    padding: 0 1;
}

#provider-field-help {
    height: auto;
    max-height: 8;
    overflow-y: auto;
    padding: 1;
    background: #0d1117;
    border-top: solid #30363d;
    color: #c9d1d9;
}

#provider-edit-error {
    height: auto;
    max-height: 3;
    padding: 0 1;
}

/* Curated Skill and MCP managers */
SkillMarketplaceScreen,
McpMarketplaceScreen,
McpInstallConfigScreen {
    align: center middle;
}

#skill-marketplace-container,
#mcp-marketplace-container {
    width: 92%;
    max-width: 118;
    height: 92%;
    background: #161b22;
    border: solid #30363d;
}

#skill-marketplace-title,
#mcp-marketplace-title,
#mcp-install-title {
    height: 1;
    padding: 0 1;
    background: #0d1117;
    color: #58a6ff;
}

#skill-marketplace-list,
#mcp-marketplace-list {
    height: 1fr;
    min-height: 8;
    padding: 0 1;
    border-bottom: solid #30363d;
}

#skill-marketplace-detail,
#mcp-marketplace-detail {
    height: auto;
    max-height: 13;
    overflow-y: auto;
    padding: 1;
    background: #0d1117;
    color: #c9d1d9;
}

#skill-marketplace-footer,
#mcp-marketplace-footer,
#mcp-install-footer {
    height: auto;
    max-height: 2;
    padding: 0 1;
}

#mcp-install-container {
    width: 82%;
    max-width: 92;
    height: auto;
    max-height: 88%;
    overflow-y: auto;
    background: #161b22;
    border: solid #30363d;
}

#mcp-install-help,
#mcp-install-form,
#mcp-install-error {
    height: auto;
    padding: 1;
}

#mcp-install-form {
    max-height: 28;
    overflow-y: auto;
}
