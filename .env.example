# Coomi Agent 配置示例
#
# 配置架构：~/.coomi/config/providers.json 是统一的模型配置中心
# .env 仅在首次启动（providers.json 不存在时）用于自动迁移
# 后续修改模型配置请直接编辑 ~/.coomi/config/providers.json
#
# 示例 providers.json:
# {
#   "version": 1,
#   "active": "default",
#   "providers": {
#     "default": {
#       "type": "generic",
#       "display": "GLM 5.1",
#       "api_key": "sk-xxx",
#       "base_url": "https://opencode.ai/zen/go/v1",
#       "model": "glm-5.1"
#     }
#   }
# }

# ============================================
# LLM Provider 类型（首次迁移用）
# 可选值: deepseek, openai, anthropic
# ============================================
LLM_PROVIDER=deepseek

# ============================================
# DeepSeek 配置（首次迁移用）
# ============================================
DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# ============================================
# MiniMax 配置（首次迁移用）
# ============================================
MINIMAX_API_KEY=sk-xxx
MINIMAX_BASE_URL=https://api.minimaxi.com/anthropic
MINIMAX_MODEL=MiniMax-M2.7

# ============================================
# 上下文窗口配置
# ============================================
# 可选值: 128000, 256000, 512000, 1000000 等
CONTEXT_WINDOW_SIZE=256000
